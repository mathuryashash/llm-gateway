FROM golang:1.26 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w" -o /fakeupstream ./cmd/fakeupstream

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /fakeupstream /fakeupstream
EXPOSE 18101
ENTRYPOINT ["/fakeupstream"]
